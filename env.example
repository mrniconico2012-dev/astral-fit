# Copia este archivo a .env y rellena estos valores desde la consola de Firebase.
# Nunca pongas aquí una clave secreta de Gemini para incluirla en el frontend.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# URL HTTPS de tu función backend, cuando la despliegues:
VITE_AI_ENDPOINT=
